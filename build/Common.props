<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <TargetFrameworkProfile />
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <WarningLevel>4</WarningLevel>
    <OutputPath Condition="'$(OutputPath)' == ''">$(MSBuildThisFileDirectory)..\artifacts\bin\</OutputPath>
    <ArtifactsRoot Condition="'$(ArtifactsRoot)' == ''">$(MSBuildThisFileDirectory)..\artifacts</ArtifactsRoot>
    <BaseIntermediateOutputPath>$(ArtifactsRoot)\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)$(Configuration)\</IntermediateOutputPath>
    <FrameworkRuntimeDirectory>$(SystemRoot)\Microsoft.NET\Framework64\v4.0.30319</FrameworkRuntimeDirectory>
    <GeneratedVersionFile Condition="'$(GeneratedVersionFile)' == ''">$(MSBuildThisFileDirectory)VersionInfo.cs</GeneratedVersionFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(GeneratedVersionFile)"><Link>Properties\VersionInfo.cs</Link></Compile>
    <Reference Include="System"><HintPath>$(FrameworkRuntimeDirectory)\System.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Core"><HintPath>$(FrameworkRuntimeDirectory)\System.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Web.Extensions"><HintPath>$(FrameworkRuntimeDirectory)\System.Web.Extensions.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
